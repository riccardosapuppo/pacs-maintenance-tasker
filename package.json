{
  "name": "pacs-maintenance-tasker",
  "version": "1.0.0",
  "private": true,
  "description": "A maintenance job that deletes medical images it cannot get back, and the three things it has to be right about first.",
  "author": "Riccardo Sapuppo",
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "start": "node src/index.js",
    "test": "node --test test/*.test.js",
    "measure": "node tools/measure.mjs",
    "run:dry": "node tools/run-once.mjs",
    "run:for-real": "node tools/run-once.mjs --for-real",
    "check:screen": "node tools/through-the-screen.mjs",
    "check:serving": "node tools/how-it-is-served.mjs",
    "check:mark": "node tools/check-mark.mjs",
    "screenshots": "node tools/screenshots.mjs"
  },
  "devDependencies": { "playwright-core": "^1.48.0" },
  "license": "MIT"
}
