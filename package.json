{
  "name": "pacs-maintenance-tasker",
  "version": "1.0.0",
  "private": true,
  "description": "A maintenance job that deletes medical images it cannot get back, and the three things it has to be right about first.",
  "author": "Riccardo Sapuppo",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/index.ts",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "measure": "node tools/measure.ts",
    "run:dry": "node tools/run-once.ts",
    "run:for-real": "node tools/run-once.ts --for-real",
    "check:screen": "node tools/through-the-screen.ts",
    "check:serving": "node tools/how-it-is-served.ts",
    "check:mark": "node tools/check-mark.ts",
    "check:paths": "node tools/what-the-readme-points-at.ts",
    "screenshots": "node tools/screenshots.ts"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "playwright-core": "^1.48.0",
    "typescript": "^5.9.0"
  },
  "license": "MIT"
}
